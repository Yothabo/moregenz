{
  "name": "simatu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run check-sizes",
    "build:analyze": "tsc && vite build && node scripts/check-file-sizes.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "clean": "rm -rf dist node_modules",
    "check-sizes": "node scripts/check-file-sizes.js",
    "dev:local": "set -a && . ./.env && set +a && concurrently -k -n FUNCTIONS,VITE -c cyan,green \"netlify functions:serve --functions netlify/functions --port 9999\" \"vite --host 0.0.0.0\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@emailjs/browser": "^3.11.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.18.0",
    "@supabase/supabase-js": "^2.118.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "ogl": "^1.0.11",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^6.20.1",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "^0.34.6",
    "autoprefixer": "^10.4.16",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^10.0.6",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^22.1.0",
    "netlify-cli": "^27.16.1",
    "postcss": "^8.4.31",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vite-plugin-babel-macros": "^1.0.6",
    "vitest": "^0.34.6"
  },
  "keywords": [
    "simatu",
    "commerce-platform",
    "multi-store-commerce",
    "ecommerce",
    "online-store",
    "storefront-management",
    "retail-management",
    "product-catalogue",
    "inventory-management",
    "order-management",
    "business-administration",
    "react",
    "typescript",
    "vite"
  ]
}
